# Plantilla para producción (hosting compartido o servidor propio).
# Copia a .env en el servidor y cambia los valores marcados con CAMBIAR.

APP_NAME="Tiempo"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false               # NUNCA true en producción: mostraría datos internos
APP_URL=https://CAMBIAR.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB / MySQL (lo que trae el hosting compartido)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

# En hosting compartido no hay procesos en segundo plano: todo sale en el momento
# y los avisos programados corren con una línea de cron (ver README).
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BCRYPT_ROUNDS=12

# Correo: usa un servicio de envío (Amazon SES, Postmark, Brevo...), no el correo del hosting.
# Los emails de aprobación son el corazón del sistema y deben llegar a la bandeja de entrada.
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="tiempo@CAMBIAR.com"
MAIL_FROM_NAME="${APP_NAME}"
