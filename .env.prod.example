# Variables de producción para docker-compose.prod.yml. Copia a .env.prod y cambia lo marcado CAMBIAR.
# .env.prod tiene secretos: NO se sube a GitHub (está en .gitignore) y se guarda aparte, igual que el respaldo.

# --- Dominio y HTTPS (Let's Encrypt, automático) ---
DOMAIN=tiempo.CAMBIAR.com          # el dominio de la aplicación; en Cloudflare, registro A con la IP del servidor y nube GRIS (solo DNS)
APP_URL=https://tiempo.CAMBIAR.com # igual que DOMAIN, con https://

# --- Aplicación ---
APP_NAME=Tiempo
APP_KEY=                           # base64:... La MISMA siempre. Nueva: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=daily
LOG_LEVEL=warning
SESSION_SECURE_COOKIE=true
BCRYPT_ROUNDS=12
TRUSTED_PROXIES=*                  # la aplicación solo es alcanzable desde Caddy (no publica puertos), por eso se confía en su X-Forwarded-Proto

# --- Base de datos (MariaDB del compose; o RDS: borra el servicio db y pon DB_HOST) ---
DB_DATABASE=tiempo
DB_USERNAME=tiempo
DB_PASSWORD=CAMBIAR-clave-larga-y-unica
DB_ROOT_PASSWORD=CAMBIAR-otra-clave-larga-y-unica

# --- Correo con Brevo (SMTP). Brevo > SMTP y API > SMTP: ahí salen el servidor, el usuario y la clave SMTP ---
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=CAMBIAR                # el "login" SMTP que muestra Brevo (no es la clave de la API)
MAIL_PASSWORD=CAMBIAR                # la clave SMTP de Brevo
MAIL_FROM_ADDRESS=tiempo@CAMBIAR.com # debe estar verificado en Brevo (Remitentes y dominios); autentica el dominio con SPF/DKIM
MAIL_FROM_NAME=Tiempo

# --- Cloudflare Turnstile en el login web (opcional; panel de Cloudflare > Turnstile). Sin llaves queda apagado ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Programador disparado desde fuera (opcional): POST https://DOMINIO/api/cron/run con el encabezado X-Cron-Key. 32+ caracteres ---
CRON_KEY=
