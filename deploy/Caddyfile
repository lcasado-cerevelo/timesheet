# Caddy: pone el HTTPS (certificado de Let's Encrypt, pedido y renovado solo) y le pasa el tráfico a la aplicación.
# Requisitos de Let's Encrypt: el dominio apunta a la IP de este servidor (en Cloudflare, nube GRIS = solo DNS) y los puertos 80 y 443
# están abiertos a internet. Los certificados se guardan en el volumen caddy_data: no lo borres o se pedirán de nuevo (hay límites).
# Un dominio o subdominio por compañía (companies.domain): Caddy puede pedir el certificado al primer acceso, pero solo para dominios
# que la aplicación reconozca. Para activarlo, agrega arriba en el bloque global (y vuelve a cargar Caddy):
#
#   {
#   	on_demand_tls {
#   		ask http://app:80/api/domain-check
#   	}
#   }
#
# y un bloque adicional que atienda cualquier dominio autorizado (el DNS de cada compañía debe apuntar a este servidor):
#
#   https:// {
#   	tls {
#   		on_demand
#   	}
#   	encode zstd gzip
#   	reverse_proxy app:80
#   }
#
# Caddy llama a GET /api/domain-check?domain=<host>: responde 200 si alguna compañía tiene ese dominio y 404 si no.

{$DOMAIN} {
	encode zstd gzip

	# Lo que sube la gente (logos) no pasa de unos MB
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy manda X-Forwarded-Proto/For por su cuenta; la aplicación confía en ellos (TRUSTED_PROXIES).
	reverse_proxy app:80 {
		health_uri /up
		health_interval 30s
	}
}
